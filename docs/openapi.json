{
  "openapi": "3.0.3",
  "info": {"title": "ВоФК НУХТ — API розкладу", "version": "2.0.0", "description": "Використовуйте /api/v1 або /api/v2 замість /api/{version}. v2 додає дату, тип заняття, підгрупу, коментар та статус публікації. Захищені запити використовують cookie після POST /session."},
  "servers": [{"url": "/api/v1", "description": "Базовий формат"}, {"url": "/api/v2", "description": "Розширений формат заняття"}],
  "components": {
    "securitySchemes": {"sessionCookie": {"type": "apiKey", "in": "cookie", "name": "session"}},
    "parameters": {"id": {"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}}},
    "schemas": {
      "Error": {"type": "object", "properties": {"error": {"type": "object", "properties": {"message": {"type": "string"}, "status": {"type": "integer"}}, "required": ["message", "status"]}}, "required": ["error"]},
      "Group": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"type": "string"}, "course": {"type": "integer"}}, "required": ["id", "name", "course"]},
      "Subject": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}, "required": ["id", "name"]},
      "Lesson": {"type": "object", "description": "У v2 додано date, lesson_type, subgroup, comment, is_published.", "properties": {"id": {"type": "integer"}, "group_id": {"type": "integer"}, "group": {"type": "string"}, "subject_id": {"type": "integer"}, "subject": {"type": "string"}, "teacher_id": {"type": "integer"}, "teacher": {"type": "string"}, "classroom_id": {"type": "integer"}, "classroom": {"type": "string"}, "day_of_week": {"type": "integer", "minimum": 1, "maximum": 5}, "pair_number": {"type": "integer", "minimum": 1, "maximum": 6}, "starts_at": {"type": "string", "example": "08:00"}, "ends_at": {"type": "string", "example": "09:20"}, "date": {"type": "string", "format": "date", "description": "Лише v2"}, "lesson_type": {"type": "string", "enum": ["", "lecture", "practice", "lab"], "description": "Лише v2"}, "subgroup": {"type": "string", "description": "Лише v2"}, "comment": {"type": "string", "nullable": true, "description": "Лише v2"}, "is_published": {"type": "boolean", "description": "Лише v2"}}, "required": ["id", "group_id", "group", "subject_id", "subject", "teacher_id", "teacher", "classroom_id", "classroom", "day_of_week", "pair_number", "starts_at", "ends_at"]},
      "LessonInput": {"type": "object", "properties": {"group_id": {"type": "integer", "example": 1}, "subject_id": {"type": "integer", "example": 1}, "teacher_id": {"type": "integer", "example": 2}, "classroom_id": {"type": "integer", "example": 1}, "day_of_week": {"type": "integer", "minimum": 1, "maximum": 5, "example": 5}, "pair_number": {"type": "integer", "minimum": 1, "maximum": 6, "example": 4}, "lesson_type": {"type": "string", "enum": ["", "lecture", "practice", "lab"], "example": "lab"}, "subgroup": {"type": "string", "enum": ["", "1", "2", "3", "4", "5", "6", "7", "8", "9"], "example": ""}, "is_published": {"type": "boolean", "example": true}}, "required": ["group_id", "subject_id", "teacher_id", "classroom_id", "day_of_week", "pair_number", "lesson_type", "subgroup", "is_published"], "additionalProperties": false},
      "FeedbackInput": {"type": "object", "properties": {"name": {"type": "string", "example": "Студент"}, "email": {"type": "string", "format": "email", "example": "student@example.com"}, "message": {"type": "string", "example": "Уточніть аудиторію"}}, "required": ["name", "email", "message"], "additionalProperties": false},
      "CommentInput": {"type": "object", "properties": {"body": {"type": "string", "example": "Візьміть ноутбуки"}}, "required": ["body"], "additionalProperties": false},
      "Credentials": {"type": "object", "properties": {"email": {"type": "string", "example": "admin@vofknuht.local"}, "password": {"type": "string", "format": "password"}}, "required": ["email", "password"], "additionalProperties": false}
    },
    "responses": {"BadRequest": {"description": "Некоректні дані", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "Unauthorized": {"description": "Потрібен вхід", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "Forbidden": {"description": "Недостатньо прав", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "NotFound": {"description": "Не знайдено", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "Conflict": {"description": "Конфлікт розкладу", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}
  },
  "paths": {
    "/session": {"post": {"summary": "Увійти", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Credentials"}}}}, "responses": {"200": {"description": "Користувач", "content": {"application/json": {"schema": {"type": "object", "properties": {"user": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"type": "string"}, "role": {"type": "string"}}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}}, "delete": {"summary": "Вийти", "responses": {"204": {"description": "Сеанс завершено"}}}},
    "/groups": {"get": {"summary": "Список груп", "responses": {"200": {"description": "Групи", "content": {"application/json": {"schema": {"type": "object", "properties": {"groups": {"type": "array", "items": {"$ref": "#/components/schemas/Group"}}}}}}}}}},
    "/subjects": {"get": {"summary": "Список предметів", "responses": {"200": {"description": "Предмети", "content": {"application/json": {"schema": {"type": "object", "properties": {"subjects": {"type": "array", "items": {"$ref": "#/components/schemas/Subject"}}}}}}}}}},
    "/groups/{id}/lessons": {"get": {"summary": "Опубліковані пари групи", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Пари", "content": {"application/json": {"schema": {"type": "object", "properties": {"lessons": {"type": "array", "items": {"$ref": "#/components/schemas/Lesson"}}}}}}}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/lessons/{id}": {"get": {"summary": "Одна пара", "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "Пара", "content": {"application/json": {"schema": {"type": "object", "properties": {"lesson": {"$ref": "#/components/schemas/Lesson"}}}}}}, "404": {"$ref": "#/components/responses/NotFound"}}}, "patch": {"summary": "Змінити пару", "security": [{"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "example": {"pair_number": 5, "is_published": false}}}}}, "responses": {"200": {"description": "Оновлена пара", "content": {"application/json": {"schema": {"type": "object", "properties": {"lesson": {"$ref": "#/components/schemas/Lesson"}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}, "delete": {"summary": "Видалити пару", "security": [{"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"204": {"description": "Видалено"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/lessons": {"post": {"summary": "Створити пару", "security": [{"sessionCookie": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LessonInput"}}}}, "responses": {"201": {"description": "Створена пара", "content": {"application/json": {"schema": {"type": "object", "properties": {"lesson": {"$ref": "#/components/schemas/Lesson"}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/feedback": {"post": {"summary": "Надіслати відгук", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FeedbackInput"}}}}, "responses": {"201": {"description": "Відгук створено", "content": {"application/json": {"schema": {"type": "object", "properties": {"feedback": {"$ref": "#/components/schemas/FeedbackInput"}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}}}, "get": {"summary": "Список відгуків для адміністратора", "security": [{"sessionCookie": []}], "responses": {"200": {"description": "Відгуки", "content": {"application/json": {"schema": {"type": "object", "properties": {"feedback": {"type": "array", "items": {"$ref": "#/components/schemas/FeedbackInput"}}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/lessons/{id}/comment": {"put": {"summary": "Створити або змінити коментар своєї пари", "security": [{"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommentInput"}}}}, "responses": {"200": {"description": "Коментар змінено", "content": {"application/json": {"schema": {"type": "object", "properties": {"comment": {"$ref": "#/components/schemas/CommentInput"}}}}}}, "201": {"description": "Коментар створено"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "delete": {"summary": "Видалити свій коментар", "security": [{"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/id"}], "responses": {"204": {"description": "Коментар видалено"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}}}
  }
}
